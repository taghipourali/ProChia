# Copy to infra/.env for docker compose.
ROOT_DOMAIN=prochia.ir
DB_PASSWORD=change-me
# 32+ random characters: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=true

# Registry mirror reachable from your server (Docker Hub is blocked in Iran).
IMAGE_REGISTRY=docker.arvancloud.ir

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=prochia-otp

PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
